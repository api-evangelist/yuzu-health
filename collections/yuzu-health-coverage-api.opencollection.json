            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v2/coverages/:coverageId/generate-id-card/svg",
            "params": [
              {
                "name": "coverageId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Generate an ID card for a coverage as an SVG"
        },
        {
          "info": {
            "name": "Generate an ID card",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v2/coverages/:coverageId/generate-id-card/b64",
            "params": [
              {
                "name": "coverageId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Generate an ID card for a coverage as a b64 encoded string of the PNG image"
        },
        {
          "info": {
            "name": "Generate an ID card",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v2/coverages/:coverageId/generate-id-card/pdf",
            "params": [
              {
                "name": "coverageId",
                "value": "",
                "type": "path"
              }
